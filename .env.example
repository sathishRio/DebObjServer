# Copy this file to .env and fill in your values.

# Your MongoDB server connection string (database name at the end).
MONGODB_URI=mongodb://localhost:27017/assistant

# Port the API listens on. The phone connects to http://<this-PC-IP>:PORT
PORT=4000

# ---------- Google sign-in ----------
# OAuth "Web application" client ID from Google Cloud Console (see README: Google sign-in setup).
# Both the web app and the mobile app sign in with this ID.
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Client secret of that same OAuth client. Only needed to import bank statements from Gmail
# (Wealth > Accounts). Enable the Gmail API in the same Google Cloud project.
GOOGLE_CLIENT_SECRET=
# Optional extra client IDs to accept, comma-separated (normally not needed).
GOOGLE_EXTRA_CLIENT_IDS=

# Only these Google accounts can use the app (comma-separated).
ALLOWED_EMAILS=you@example.com

# Secret used to sign session tokens. Keep it private; changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a sign-in lasts.
SESSION_DAYS=30

# ---------- Password vault (web) ----------
# Combined with your 4-digit PIN to encrypt saved passwords. It is NOT stored in the database.
# BACK IT UP somewhere safe (e.g. your own password manager): if this value is lost or changed,
# every saved password becomes permanently unreadable.
VAULT_SECRET=change-me-to-a-long-random-string
# Shows Export / Import on the Vault page (decrypted backup of passwords + Wealth data).
# Turn on only while moving data, then set back to false.
VAULT_TRANSFER=false

# ---------- Dev mode ----------
# true = the sign-in page shows an "Admin" button that logs in as the first ALLOWED_EMAILS account
# without Google. Works only from this PC / your local network. Turn OFF before putting the server online.
DEV_LOGIN=true
